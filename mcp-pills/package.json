{
  "name": "paseo-mcp-pills",
  "version": "0.1.0",
  "private": true,
  "description": "Browse agent-scoped MCP configuration and server interfaces from a composer pill",
  "homepage": "https://github.com/yuruiz/paseo-plugins/tree/main/mcp-pills#readme",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuruiz/paseo-plugins.git",
    "directory": "mcp-pills"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --bail=1",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "smol-toml": "1.6.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.0",
    "@getpaseo/plugin": "0.13.0",
    "@getpaseo/protocol": "0.13.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
