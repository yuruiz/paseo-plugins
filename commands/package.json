{
  "name": "paseo-commands",
  "version": "0.1.0",
  "private": true,
  "description": "Browse and run project, global and session commands from a popover in Paseo.",
  "homepage": "https://github.com/yuruiz/paseo-commands#readme",
  "bugs": {
    "url": "https://github.com/yuruiz/paseo-commands/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuruiz/paseo-commands.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run server/commands.test.ts --bail=1",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:files": "oxfmt"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
