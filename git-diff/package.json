{
  "name": "paseo-git-diff-review",
  "version": "0.4.1",
  "private": true,
  "description": "Compare branches and inclusive commit ranges, review files and browse submodule history.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuruiz/paseo-plugins.git",
    "directory": "git-diff"
  },
  "homepage": "https://github.com/yuruiz/paseo-plugins/tree/main/git-diff",
  "bugs": {
    "url": "https://github.com/yuruiz/paseo-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "docs/",
    "OVERVIEW.md",
    "OVERVIEW.zh-CN.md",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run check:version && npm run typecheck && npm run lint && npm test",
    "sync:version": "tsx scripts/sync-version.ts",
    "check:version": "tsx scripts/sync-version.ts --check",
    "version": "npm run sync:version && git add shared/version.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "check:compatibility": "tsx scripts/check-compatibility.ts",
    "dev:ui": "vite --config tests/browser/vite.config.ts",
    "verify:installed": "tsx scripts/verify-installed.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:assets": "tsx scripts/build-assets.ts",
    "format:check": "biome format .",
    "verify:review": "tsx scripts/verify-review.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@getpaseo/client": "0.16.0-beta.1",
    "@getpaseo/plugin": "0.16.0-beta.1",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vscode/codicons": "^0.0.46-24",
    "mermaid": "^12.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "zod": "^4.4.3"
  }
}
