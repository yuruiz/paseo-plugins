{
  "name": "paseo-plugins",
  "private": true,
  "description": "Independently installable Paseo plugins maintained in one repository",
  "type": "module",
  "scripts": {
    "setup": "node scripts/plugins.mjs setup",
    "check": "node --check scripts/plugins.mjs && node scripts/plugins.mjs check",
    "typecheck": "node scripts/plugins.mjs typecheck",
    "lint": "node scripts/plugins.mjs lint",
    "format": "node scripts/plugins.mjs format",
    "format:check": "node scripts/plugins.mjs format:check",
    "test": "node scripts/plugins.mjs test"
  },
  "engines": {
    "node": ">=22"
  }
}
