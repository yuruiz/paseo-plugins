{
  "name": "paseo-plugin-secrets",
  "version": "0.5.0",
  "private": true,
  "description": "Private inputs with one-use execution grants, plus 1Password Connect access and item browsing for Paseo agents.",
  "homepage": "https://github.com/yuruiz/paseo-plugins/tree/main/secrets#readme",
  "bugs": {
    "url": "https://github.com/yuruiz/paseo-plugins/issues"
  },
  "license": "Apache-2.0",
  "author": "Zhou Yurui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuruiz/paseo-plugins.git",
    "directory": "secrets"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "assets/"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --bail=1",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "socks-proxy-agent": "10.1.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^20.9.0",
    "@types/react": "^19.1.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.7",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
