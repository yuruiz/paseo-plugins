{
  "name": "paseo-skills",
  "version": "0.4.1",
  "private": true,
  "description": "Paseo plugin: lists the skills an agent can use, shows where each comes from, renders its SKILL.md, and invokes it",
  "homepage": "https://github.com/yuruiz/paseo-plugins/tree/main/skills#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuruiz/paseo-plugins.git",
    "directory": "skills"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "CHANGELOG.md",
    "!**/*.test.ts",
    "OVERVIEW.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --bail=1",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.0",
    "@getpaseo/plugin": "0.13.0",
    "@getpaseo/protocol": "0.13.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
