{
  "name": "paseo-shell-yeah",
  "version": "1.2.3",
  "private": true,
  "description": "Type /sh and a command to run it as you, in the agent's folder, with live output in the chat. The agent sees it only if you send it.",
  "keywords": [
    "command",
    "paseo",
    "paseo-plugin",
    "shell",
    "terminal"
  ],
  "homepage": "https://github.com/yuruiz/paseo-plugins/tree/main/shell-yeah#readme",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuruiz/paseo-plugins.git",
    "directory": "shell-yeah"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "images/",
    "icon.png",
    "tsconfig.json",
    "!**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
