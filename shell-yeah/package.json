    "@types/react": "~19.2.0",
    "node-pty": "1.2.0-beta.15",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.43.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  }
